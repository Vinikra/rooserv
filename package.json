{
  "name": "rooserv",
  "version": "1.0.0",
  "private": true,
  "description": "RooServ - Plataforma hiperlocal de contratação de serviços em Rondonópolis com pagamentos em custódia e split de comissões",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm --workspace=@servicos/shared run build && npm --workspace=@servicos/mobile run build",
    "build:shared": "npm --workspace=@servicos/shared run build",
    "build:mobile": "npm --workspace=@servicos/mobile run build",
    "dev": "npm --workspace=@servicos/mobile run dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "servicos",
    "marketplace",
    "escrow",
    "rondonopolis",
    "rooserv",
    "react",
    "supabase"
  ],
  "author": "Vinikra",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "vitest": "^4.1.11"
  }
}
