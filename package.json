{
  "name": "rooserv",
  "version": "1.0.0",
  "private": true,
  "description": "RooServ - Plataforma hiperlocal de contratação de serviços em Rondonópolis com pagamentos Pix e acompanhamento de repasses",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm --workspace=@servicos/shared run build && npm --workspace=@servicos/mobile run build",
    "build:shared": "npm --workspace=@servicos/shared run build",
    "build:mobile": "npm --workspace=@servicos/mobile run build",
    "dev": "npm --workspace=@servicos/mobile run dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ci": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "verify:release": "node scripts/verify-release-config.mjs",
    "check:live": "node scripts/check-live-security.mjs",
    "check:release": "npm run test && npm run build && npm run verify:release && npm run test:e2e:ci",
    "test:payments:sandbox": "node scripts/abacatepay-sandbox-smoke.mjs --simulate",
    "test:staging:financial": "node scripts/staging-financial-e2e.mjs --confirm-staging",
    "cleanup:staging:financial": "node scripts/cleanup-staging-financial-e2e.mjs --confirm-staging --delete-fixtures",
    "migrate:staging:legacy-media": "node scripts/migrate-staging-legacy-media.mjs --confirm-staging --migrate"
  },
  "keywords": [
    "servicos",
    "marketplace",
    "pix",
    "rondonopolis",
    "rooserv",
    "react",
    "supabase"
  ],
  "author": "Vinikra",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "vitest": "^4.1.11"
  }
}
